# API base URL. Baked in at build time, so rebuild after changing it.
VITE_API_URL=http://localhost:5000/api/v1

# In production this must be the public API URL, for example:
# VITE_API_URL=https://api.example.com/api/v1
# If the frontend and API share a domain behind nginx, use a path instead:
# VITE_API_URL=/api/v1
